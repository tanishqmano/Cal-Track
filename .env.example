# Copy this file to .env and paste your key in.
#   cp .env.example .env
#
# Pick which backend the app talks to.
#   nvidia    NVIDIA NIM  (default)
#   gemini    Google Gemini
#   anthropic Claude
AI_PROVIDER=gemini

# --- NVIDIA NIM ---------------------------------------------------------
# Free key at https://build.nvidia.com  ->  any model page  ->  "Get API Key"
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Any OpenAI-compatible endpoint works here. To use OpenRouter instead:
#   NVIDIA_BASE_URL=https://openrouter.ai/api/v1
#   NVIDIA_API_KEY=sk-or-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Google Gemini ------------------------------------------------------
# Free key at https://aistudio.google.com/apikey
# This goes through Google's OpenAI-compatible endpoint, so it uses the same
# wire format as NVIDIA above.
GEMINI_API_KEY=AIza-your-key-here
# The 2.0 and 2.5 models are closed to new keys (404 / no free quota). The
# -lite models skip the thinking pass, which is ~5x cheaper for estimation
# work like this and cannot truncate the reply.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Claude -------------------------------------------------------------
# Key at https://platform.claude.com  ->  API keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- who is allowed in --------------------------------------------------
# Leave empty on home Wi-Fi, where the audience is whoever is in the house.
#
# Set it before putting this on a public address. Without it, anyone who finds
# the URL can read and edit your log — and can spend your API key, because
# /api/parse adds the key for whoever calls it. Each device asks once.
PASSPHRASE=

# --- logging from the Claude app ----------------------------------------
# Switches on /mcp, which lets Claude write to the log directly — take a photo
# of a plate in the Claude app and it lands here. Claude reads the photo itself,
# so this route never spends the API key above.
#
# Empty means the endpoint is off, not open. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# It travels in the connector URL (https://your-app/mcp/<token>), so give it its
# own value rather than reusing PASSPHRASE.
MCP_TOKEN=

# The timezone you eat in, used only when Claude does not name a meal itself.
# Without it, a host running in UTC files an 8pm dinner as lunch — or, from the
# US West Coast, as the next morning's breakfast.
#
# An IANA zone name: America/Los_Angeles, America/Denver, America/Chicago,
# America/New_York, Asia/Kolkata. Use the name rather than an offset wherever
# the clocks change, since the offset is only right for half the year.
LOG_TZ=America/Los_Angeles

# Only for zones that never change their clocks (America/Phoenix, Pacific/
# Honolulu), and for configs written before LOG_TZ existed. Ignored when LOG_TZ
# is set and valid. Minutes ahead of UTC: 330 for India, -480 for US Pacific.
LOG_UTC_OFFSET_MIN=

# --- where the food log is kept -----------------------------------------
# Every device reads and writes one shared log. Two places to keep it:
#
#   file    data/state.json next to the code. Nothing to install, but the log
#           lives on this machine, so the app can only run on this machine.
#   mongo   A MongoDB database. Needed to host the app anywhere else, since
#           web hosts wipe their disks on restart.
#
# Left blank, this picks mongo when MONGODB_URI is set and file when it is not.
STORE=

# Free cluster at https://www.mongodb.com/cloud/atlas
#   Connect -> Drivers -> copy the URI, then put your password in place of
#   <db_password> and allow your host under Network Access.
# The first start with an empty database imports data/state.json for you.
MONGODB_URI= 
MONGODB_DB=macro-tracker
MONGODB_COLLECTION=logs
